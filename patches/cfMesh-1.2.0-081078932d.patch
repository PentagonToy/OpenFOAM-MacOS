diff --git a/.gitignore b/.gitignore
new file mode 100644
index 0000000..dbac271
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1,12 @@
+# wmake-generated build artifacts
+lnInclude/
+Make/linux64*/
+Make/linuxArm64*/
+Make/darwin64*/
+Make/darwinArm64*/
+*.o
+*.dep
+*.dylib
+*.so
+*.exe
+*.exe.dSYM/
diff --git a/Allwmake b/Allwmake
index d766775..1a5f98b 100755
--- a/Allwmake
+++ b/Allwmake
@@ -6,4 +6,24 @@ wmake libso meshLibrary
 wmake all executables
 
 # Compile utilities
-wmake all utilities
+#
+# NOTE: importSurfaceAsSubset and extrudeEdgesInto2DSurface are not
+# buildable from the 1.2.0 release sources (their headers
+# triSurfaceImportSurfaceAsSubset.H / triSurfaceExtrude2DEdges.H are
+# missing from the distribution), so they are skipped.  This is a
+# platform-independent workaround (Linux, macOS, Windows/mingw).
+for _util in utilities/*/Make
+do
+    _dir=${_util%/Make}
+    case ${_dir##*/} in
+    importSurfaceAsSubset|extrudeEdgesInto2DSurface)
+        echo "cfMesh: skipping ${_dir##*/} (missing source header in 1.2.0 release)"
+        ;;
+    *)
+        wmake all "$_dir" || exit 1
+        ;;
+    esac
+done
+unset _util _dir
+
+#------------------------------------------------------------------------------
